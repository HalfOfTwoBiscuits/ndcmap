<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>me.sirrahmas</groupId>
    <artifactId>ndcmap</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>me.sirrahmas.ndcmap.NDCMap</exec.mainClass>
    </properties>

    <dependencies>
        <!-- 
            Web framework. 
            Source: https://mvnrepository.com/artifact/io.javalin/javalin
        -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>7.2.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- 
            Simple logger for Javalin.
            Source: the Javalin console output suggested I put it in.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!--
            Database engine.
            Source: https://mvnrepository.com/artifact/com.arcadedb/arcadedb-engine
        -->
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>26.4.2</version>
            <scope>compile</scope>
        </dependency>

        <!--
            Unit test framework.
            Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>

        <!--
            Template renderer for Javalin.
            Source: https://javalin.io/plugins/rendering    
        -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin-rendering-freemarker</artifactId>
            <version>7.2.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Assembly plugin.
                Compile project and its dependencies to a .jar file.
                Unlike the compiler and resources plugins, it doesn't have a default
                configuration and must be specified explicitly here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>
                                        me.sirrahmas.ndcmap.NDCMap
                                    </mainClass>
                                </manifest>
                            </archive>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>